# .claude/: the shared agent config (skills, commands, project settings) IS tracked --
# it is part of how this project is built. Only per-machine and runtime state stays out.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/**/*.local.*
.claude/worktrees/

# --- Quartus build artifacts (regenerated by compile; never commit) ---
db/
incremental_db/
output_files/
qdb/
.qsys_edit/
hps_isw_handoff/
hc_output/
greybox_tmp/
*.qws
*.rpt
*.summary
*.smsg
*.qmsg
*.pin
*.jdi
*.sof
*.pof
*.sld
*.cdf
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt
build.log
compile_output.log
# generated by sys/build_id.tcl on every compile
build_id.v

# --- Simulation artifacts (compiled by iverilog; regenerated) ---
*.vvp
*.vcd
*.lxt
*.ppm
bench/**/*_sim
bench/h264/*.log
# fixture slices and generated streams -- never commit media
bench/h264/fixtures/gen/
# agent/session scratch: compiled sims, build logs, merged-file scratch
.sim/

# --- Built cores (keep out of git -- build_release.sh names them; .gitkeep only) ---
# Everything under releases/ except .gitkeep: a `git add -A` from the root would take
# built .rbf files and any test media left there (MiSTer_DVD nearly committed 330 MB).
releases/*
!releases/.gitkeep

# --- Local notifier endpoint (Discord webhook / ntfy topic) -- secret, never commit
tools/.notify_url
# --- hardware-in-the-loop harness: rig-specific, never commit
tools/.mister_host
# The Jellyfin server for R1 / the rig tests: URL and the test account (never committed)
tools/.jellyfin
tools/.mister_state.json
tools/.mister_capture.json

__pycache__/
*.pyc

# --- User manual build output (MkDocs; regenerated by mkdocs build / CI) ---
# NOTE: `site/` is the manual's SOURCE and IS tracked. The stock MkDocs .gitignore
# snippet says `site/` because that is MkDocs' DEFAULT output dir -- do NOT add it here.
# mkdocs.yml overrides site_dir to .site-build precisely so the two can never be confused.
.site-build/
.cache/

# --- Local Python venvs (mkdocs preview, tooling) ---
.venv/
venv/

# --- OS / editor junk ---
.DS_Store
main/.build/

# --- hps/ builds (host and ARM; hps/build_arm.sh, the Makefile) ---
hps/build/
# --- clients/moonlight builds (the upstream checkout, the ARM binary; clients/moonlight/build.sh) ---
clients/moonlight/build/
# --- clients/jellyfin builds (the ARM binary, build/dist, the host build; clients/jellyfin/build.sh) ---
clients/jellyfin/build/
# --- clients/player builds (the ARM binary, build/dist, the host build, the test; clients/player/build.sh) ---
clients/player/build/
# --- clients/uvc builds (h264cam, ARM and host; clients/uvc/build.sh) ---
clients/uvc/build/

# the composite-sync benches (bench/h264/run_csync_field.sh): generated from sys/sys_top.v
bench/h264/csync_ref_gen.v
bench/h264/csync_pipe_gen.vh
bench/h264/csync_field_sim
bench/h264/csync_red_arm.log
bench/h264/csync_smpte_red.sv
