# ---- MiSTer framework (sys/) ------------------------------------------------------------
source sys/sys.tcl
set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:sys/build_id.tcl"
set_global_assignment -name CDF_FILE jtag.cdf
set_global_assignment -name QIP_FILE sys/sys.qip
# (perf/retime) the fitter's own clk_dec target: after sys.qip, whose sys_top.sdc derives the PLL clocks
set_global_assignment -name SDC_FILE h264/h264_fit.sdc
source sys/sys_analog.tcl

# ---- build settings ---------------------------------------------------------------------
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
# QUARTUS=1: h264/sys_pll.sv wraps its altera_pll in `ifdef QUARTUS (sim gets a pass-through).
set_global_assignment -name VERILOG_MACRO "QUARTUS=1"
# No HPS audio mixing: frees the f2sdram ram2 port for the core (docs/hw_budget_and_lessons.md),
# and audio plays against the core's own clock, not Linux's (docs/architecture.md "Audio").
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL NORMAL
