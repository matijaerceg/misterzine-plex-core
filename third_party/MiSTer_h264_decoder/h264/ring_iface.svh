localparam logic [63:0] RI_MAGIC = 64'h343632485453694D;
localparam logic [15:0] RI_VERSION = 16'h104;   // interface version, major << 8 | minor
localparam logic [31:0] RI_CTRL_BYTE = 32'h31400000;   // the control block's byte address
localparam logic [31:0] RI_RING_BYTE = 32'h31800000;   // the ring's byte address
localparam logic [31:0] RI_RING_SIZE = 32'h800000;   // the ring's size in bytes (a power of two)
localparam logic [31:0] RI_MAX_PAYLOAD = 32'h400000;   // the largest payload a record may carry
localparam logic [7:0] RI_CORE_WORDS = 8'h20;   // control words written by the core (0 .. CORE_WORDS-1)
localparam logic [7:0] RI_PROG_WORD = 8'h20;   // the first control word written by the program
localparam logic [7:0] RI_W_WRITE_INDEX = 8'h20;   // program: the write index (u32, low half; the high half is ignored)
localparam logic [7:0] RI_W_NONCE = 8'h21;   // program: the session nonce (u32, low half)
localparam logic [7:0] RI_W_PAUSE = 8'h22;   // program (0.5): the pause and attenuation (u32, low half: [0] PAUSE, [15:8] ATTEN, the rest 0)
localparam logic [7:0] RI_CTL_PAUSE_BIT = 8'h0;   // pause word: the PAUSE level
localparam logic [7:0] RI_CTL_ATTEN_LSB = 8'h8;   // pause word: ATTEN [15:8], 0.5 dB steps (0 full volume, 255 mute)
localparam logic [31:0] RI_CTL_RESERVED = 32'hFFFF00FE;   // pause word: the bits that must be 0 (a word with one set is refused whole)
localparam logic [7:0] RI_W_SETTINGS = 8'h23;   // program (0.4): the settings request (u32, low half: values, mask, seq)
localparam logic [7:0] RI_REQ_MASK_LSB = 8'hD;   // settings request: the mask's first bit (one bit an option, in the mirror's order)
localparam logic [7:0] RI_REQ_SEQ_LSB = 8'h18;   // settings request: the sequence number [31:24] (0 = no request)
localparam logic [7:0] RI_W_RUMBLE = 8'h24;   // program (0.13): the pads' rumble, words W_RUMBLE .. +2 (u32, low half: [15:0] pad 2k, [31:16] pad 2k+1)
localparam logic [7:0] RI_W_GEOMETRY = 8'h27;   // program (1.2): calibrated picture rectangle request; word 88 supplies the clip viewport
localparam logic [7:0] RI_W_GEOMETRY_CLIP = 8'h58;   // program (1.2): calibrated clip viewport, written before W_GEOMETRY
localparam logic [7:0] RI_GEOMETRY_X_LSB = 8'h27;   // geometry word 39: signed x, 13-bit two's complement (bits 51:39)
localparam logic [7:0] RI_GEOMETRY_Y_LSB = 8'h1A;   // geometry word 39: signed y, 13-bit two's complement (bits 38:26)
localparam logic [7:0] RI_GEOMETRY_W_LSB = 8'hD;   // geometry word 39: output width (bits 25:13)
localparam logic [7:0] RI_GEOMETRY_H_LSB = 8'h0;   // geometry word 39: output height (bits 12:0)
localparam logic [7:0] RI_GEOMETRY_CLIP_X_LSB = 8'h0;   // geometry clip word 88: x (bits 11:0)
localparam logic [7:0] RI_GEOMETRY_CLIP_Y_LSB = 8'hC;   // geometry clip word 88: y (bits 23:12)
localparam logic [7:0] RI_GEOMETRY_CLIP_W_LSB = 8'h18;   // geometry clip word 88: width (bits 35:24)
localparam logic [7:0] RI_GEOMETRY_CLIP_H_LSB = 8'h24;   // geometry clip word 88: height (bits 47:36)
localparam logic [7:0] RI_GEOMETRY_SEQ_LSB = 8'h38;   // geometry request word 39: nonzero request sequence
localparam logic [7:0] RI_GEOMETRY_ACK_W = 8'h1F;   // core: geometry acknowledgement in word 31 high half
localparam logic [7:0] RI_GEOMETRY_ERR_LSB = 8'h28;   // core: geometry request result (0 accepted, 1 invalid range, 2 reserved bits)
localparam logic [7:0] RI_RUMBLE_PADS = 8'h6;   // (0.13) pads with a rumble value: pad n is Main's player n+1 (the input region's pad n)
localparam logic [7:0] RI_RUMBLE_LARGE_LSB = 8'h8;   // (0.13) a pad's value: [15:8] the large (low-frequency, strong) motor, [7:0] the small (high-frequency, weak); 0 off
localparam logic [7:0] RI_POLL_WORDS = 8'h8;   // (1.2) the core's poll reads words PROG_WORD .. +7, including geometry word 39
localparam logic [7:0] RI_CORE2_WORD = 8'h28;   // (0.5) the first word of the core's second region (40-47)
localparam logic [7:0] RI_CORE2_WORDS = 8'h8;   // (0.5) its size in words
localparam logic [7:0] RI_CORE3_WORD = 8'h50;   // (0.10) the first word of the core's third region (80-87)
localparam logic [7:0] RI_CORE3_WORDS = 8'h8;   // (0.10) its size in words
localparam logic [7:0] RI_IN_WORD = 8'h30;   // (0.6) the input region's first word (in_head)
localparam logic [7:0] RI_IN_WORDS = 8'h18;   // (0.6) its size in words (in_tail is the last)
localparam logic [7:0] RI_IN_Q_WORD = 8'h38;   // (0.6) the event queue's first word: event n is entry n % IN_Q_LEN, 16 bits, four a word
localparam logic [7:0] RI_IN_Q_LEN = 8'h20;   // (0.6) the event queue's entries
localparam logic [7:0] RI_EV_TYPE_LSB = 8'hE;   // (0.6) an event's type [15:14]
localparam logic [7:0] RI_EV_KEY_PRESSED = 8'h9;   // (0.6) a key event: [9] pressed, [8] extended (E0), [7:0] the PS/2 set-2 code
localparam logic [7:0] RI_EV_KEY_EXT = 8'h8;   // (0.6) a key event: the E0 prefix
localparam logic [7:0] RI_IN_ACTIONS = 8'h2;   // (0.8) the OSD's action entries: an ACTION event's number is 0 .. IN_ACTIONS-1
localparam logic [7:0] RI_OVL_WORD = 8'h48;   // (0.9) the overlay's descriptor, words 72-79 (the program's; u32 each, low half)
localparam logic [7:0] RI_W_OVL_GEN_LO = 8'h48;   // (0.9) program: the descriptor's generation, written LAST
localparam logic [7:0] RI_W_OVL_CTL = 8'h49;   // (0.9) program: [0] ENABLE, [2:1] FORMAT (OVL_FMT_*), the rest 0
localparam logic [7:0] RI_W_OVL_BASE = 8'h4A;   // (0.9) program: the page's physical byte address (a multiple of 8)
localparam logic [7:0] RI_W_OVL_SIZE = 8'h4B;   // (0.9) program: [15:0] width 1..OVL_MAX_W, [31:16] height 1..OVL_MAX_H
localparam logic [7:0] RI_W_OVL_STRIDE = 8'h4C;   // (0.9) program: [15:0] bytes a line (a multiple of 8, >= width x bytes a pixel), [31:16] 0
localparam logic [7:0] RI_W_OVL_BAND = 8'h4D;   // (0.9) program: [15:0] the first line drawn on, [31:16] the last (only these are fetched)
localparam logic [7:0] RI_W_OVL_RSVD = 8'h4E;   // (0.9) program: reserved, 0
localparam logic [7:0] RI_W_OVL_GEN_HI = 8'h4F;   // (0.9) program: the descriptor's generation, written FIRST
localparam logic [7:0] RI_OVL_CTL_ENABLE_BIT = 8'h0;   // (0.9) ctl: ENABLE
localparam logic [7:0] RI_OVL_CTL_FMT_LSB = 8'h1;   // (0.9) ctl: FORMAT [2:1]
localparam logic [31:0] RI_OVL_CTL_RESERVED = 32'hFFFFFFF8;   // (0.9) ctl: the bits that must be 0
localparam logic [15:0] RI_OVL_MAX_W = 16'h800;   // (0.12) the canvas's widest: the widest raster (native: 2,048; 0.10: 1,024; 0.9: 720)
localparam logic [15:0] RI_OVL_MAX_H = 16'h800;   // (0.12) the canvas's tallest: the tallest raster (native: 2,048; 0.10: 2,047; 0.9: 576)
localparam logic [31:0] RI_FB_BYTE = 32'h22000000;   // (0.9) the Linux framebuffer's region (MiSTer_fb): the overlay's page lies inside it
localparam logic [31:0] RI_FB_SIZE = 32'h800000;   // (0.9) its size in bytes
localparam logic [15:0] RI_AUD_MAX_RECORDS = 16'h100;   // (0.5) unplayed AUDIO records the core holds before the reader waits
localparam logic [31:0] RI_AUD_RATE = 32'hBB80;   // (0.5) AUDIO payloads: 48 kHz, s16 little-endian, stereo interleaved (4 bytes a frame)
localparam logic [31:0] RI_DPB_BYTE = 32'h32000000;   // (0.15) the DPB's stores: store k at DPB_BYTE + k x DPB_STORE (the decoder's in a coded stream, the program's in a picture stream)
localparam logic [7:0] RI_DPB_STORES = 8'h14;   // (0.15) the stores
localparam logic [31:0] RI_DPB_STORE = 32'h200000;   // (0.15) a store's size in bytes
localparam logic [7:0] RI_PIC_PAYLOAD = 8'h20;   // (0.15) a PICTURE's payload: exactly this many bytes (four u64)
localparam logic [7:0] RI_PIC_MAX_SIDE = 8'h80;   // (0.15) a PICTURE's w_mbs / hf_mbs at most
localparam logic [15:0] RI_CAP_MAX_MBS = 16'hE10;   // (0.11) word 81's cap_max_mbs: (0.15) a PICTURE's w_mbs x hf_mbs at most
localparam logic [63:0] RI_PIC_RSV0 = 64'hFFFF00E0FC0000E0;   // (0.15) a PICTURE's P0: the bits that must be 0
localparam logic [63:0] RI_PIC_RSV1 = 64'hFFFFFFFE00000000;   // (0.15) ... P1's
localparam logic [63:0] RI_PIC_RSV3 = 64'hFFFFFF0000000000;   // (0.15) ... P3's (P2 has none)
localparam logic [7:0] RI_PIC_STRUCT_FRAME = 8'h0;   // (0.15) P0 [25:24] structure: a frame
localparam logic [7:0] RI_PIC_STRUCT_PAIR_TOP = 8'h1;   // (0.15) ... a field pair, top field first (woven)
localparam logic [7:0] RI_PIC_STRUCT_PAIR_BOT = 8'h2;   // (0.15) ... a field pair, bottom field first (woven)
localparam logic [15:0] RI_SYNC = 16'h5248;   // header word 1 [63:48]
localparam logic [7:0] RI_HDR_COLOUR_LSB = 8'h21;   // (0.16) header word 1 [35:33]: the colour code (docs/architecture.md 'The colour'); VIDEO_AU and PICTURE only
localparam logic [7:0] RI_COLOUR_AUTO = 8'h0;   // (0.16) colour 0: auto -- the stream's VUI, else the size rule (>= 1,280 wide or > 576 high: BT.709, else BT.601)
localparam logic [7:0] RI_COLOUR_601 = 8'h1;   // (0.16) colour 1: BT.601, limited range
localparam logic [7:0] RI_COLOUR_601_FULL = 8'h2;   // (0.16) colour 2: BT.601, full range
localparam logic [7:0] RI_COLOUR_709 = 8'h3;   // (0.16) colour 3: BT.709, limited range
localparam logic [7:0] RI_COLOUR_709_FULL = 8'h4;   // (0.16) colour 4: BT.709, full range
localparam logic [7:0] RI_COLOUR_2020 = 8'h5;   // (0.16) colour 5: BT.2020 (non-constant luminance), limited range
localparam logic [7:0] RI_COLOUR_2020_FULL = 8'h6;   // (0.16) colour 6: BT.2020 (non-constant luminance), full range (7: reserved, HDR_COLOUR)
localparam logic [7:0] RI_REC_ALIGN = 8'h10;   // records start on this alignment; payloads are padded to it
localparam logic [28:0] RI_CTRL_WORD = 29'h6280000;   // CTRL_BYTE / 8
localparam logic [28:0] RI_RING_WORD = 29'h6300000;   // RING_BYTE / 8
localparam int RI_RING_AW = 20;                   // log2(RING_SIZE / 8)
localparam logic [7:0] RT_INVALID = 8'd0;
localparam logic [7:0] RT_PAD = 8'd1;
localparam logic [7:0] RT_VIDEO_AU = 8'd2;
localparam logic [7:0] RT_AUDIO = 8'd3;
localparam logic [7:0] RT_CONTROL = 8'd4;
localparam logic [7:0] RT_PICTURE = 8'd5;
localparam int RF_PTS_VALID = 0;   // on VIDEO_AU, AUDIO, PICTURE
localparam int RF_DISCONTINUITY = 1;   // on VIDEO_AU, PICTURE
localparam int RF_END_OF_STREAM = 2;   // on VIDEO_AU, PICTURE
localparam int RF_LOW_LATENCY = 3;   // on VIDEO_AU, PICTURE
localparam int RF_GRAPHICS = 4;   // on VIDEO_AU, PICTURE
localparam logic [7:0] RS_UNWRITTEN = 8'd0;
localparam logic [7:0] RS_NO_SESSION = 8'd1;
localparam logic [7:0] RS_READY = 8'd2;
localparam logic [7:0] RS_PLAYING = 8'd3;
localparam logic [7:0] RS_ENDED = 8'd4;
localparam logic [7:0] RS_ERROR = 8'd5;
localparam logic [1:0] RV_KEY = 2'd0;   // event type: (0.6) a key: [9] pressed, [8] extended, [7:0] the PS/2 set-2 code (hps_io's ps2_key [9:0])
localparam logic [1:0] RV_MOUSE_BTN = 2'd1;   // event type: (0.6) the mouse buttons changed: [7:0] the buttons now (word 64's mouse_btn order)
localparam logic [1:0] RV_OSD = 2'd2;   // event type: (0.6) Main's OSD: [0] opened (1) or closed (0)
localparam logic [1:0] RV_ACTION = 2'd3;   // event type: (0.8) an OSD action chosen: [7:0] its number (0 'Send Home to the program', 1 'Program menu')
localparam logic [7:0] RE_NONE = 8'd0;   // no error
localparam logic [7:0] RE_WIDX_ALIGN = 8'd1;   // the write index is not a multiple of 16
localparam logic [7:0] RE_WIDX_RANGE = 8'd2;   // the write index is more than a ring ahead of the read index, or moved backwards
localparam logic [7:0] RE_HDR_SYNC = 8'd3;   // header word 1's sync or zero bits ([47:36]; 0.1-0.15: [47:33]) are wrong
localparam logic [7:0] RE_HDR_TYPE = 8'd4;   // type 0 or an unknown type
localparam logic [7:0] RE_HDR_FLAGS = 8'd5;   // an undefined flag, or a flag not allowed on this type
localparam logic [7:0] RE_HDR_LENGTH = 8'd6;   // a VIDEO_AU of length 0, an AUDIO of length 0 or not a multiple of 4 (0.5), a PICTURE not of PIC_PAYLOAD bytes (0.15), or any payload above MAX_PAYLOAD
localparam logic [7:0] RE_HDR_WRAP = 8'd7;   // a record crossing the ring's end, or a PAD not ending exactly there
localparam logic [7:0] RE_HDR_SEQ = 8'd8;   // the header's seq is not the next record's
localparam logic [7:0] RE_NEED_DISCONT = 8'd9;   // a VIDEO_AU (0.15: or a PICTURE) after END_OF_STREAM without DISCONTINUITY
localparam logic [7:0] RE_CONTROL_UNSUPPORTED = 8'd10;   // a CONTROL record (reserved: refused in 0.1)
localparam logic [7:0] RE_STREAM_KIND = 8'd11;   // (0.15) a PICTURE in a coded stream, or a VIDEO_AU in a picture stream (the stream's first video record decides)
localparam logic [7:0] RE_PIC_FIELD = 8'd12;   // (0.15) a PICTURE's descriptor: a reserved bit, structure 3, a pic_struct not allowed, an aspect_ratio_idc of 17-254 or 255 with a zero SAR, or timing with a zero field
localparam logic [7:0] RE_PIC_STORE = 8'd13;   // (0.15) a PICTURE's store at or above DPB_STORES
localparam logic [7:0] RE_PIC_SIZE = 8'd14;   // (0.15) a PICTURE's side 0 or above PIC_MAX_SIDE, an odd hf_mbs on a pair, or w_mbs x hf_mbs above cap_max_mbs
localparam logic [7:0] RE_PIC_CROP = 8'd15;   // (0.15) a PICTURE's crop leaving nothing
localparam logic [7:0] RE_PIC_BUSY = 8'd16;   // (0.15) a PICTURE's store still held by the display (the store rule broken)
localparam logic [7:0] RE_HDR_COLOUR = 8'd17;   // (0.16) header word 1's colour is 7, or non-zero on a PAD or an AUDIO record
localparam int RL_LOW_LATENCY = 0;   // the current stream asked for low latency
localparam int RL_EOS = 1;   // END_OF_STREAM consumed for the current stream
localparam int RL_ENDED = 2;   // the display took the stream's END (the last picture stays up)
localparam int RL_STC_RUN = 3;   // the presentation clock is anchored and counting
localparam int RL_PLAYED = 4;   // a picture has been shown since the core's reset (black between streams)
localparam int RL_OSD_OPEN = 5;   // Main's OSD is open: a program forwarding input should pause it
localparam int RL_SESSION = 6;   // a session is open
localparam int RL_GRAPHICS = 7;   // (0.4) the current stream declared rendered graphics (its first VIDEO_AU)
localparam logic [1:0] RO_FMT_1555 = 2'd0;   // (0.9) 2 bytes a pixel
localparam logic [1:0] RO_FMT_4444 = 2'd1;   // (0.9) 2 bytes a pixel
localparam logic [1:0] RO_FMT_8888 = 2'd2;   // (0.9) 4 bytes a pixel
localparam logic [1:0] RO_S_OFF = 2'd0;
localparam logic [1:0] RO_S_ACCEPTED = 2'd1;
localparam logic [1:0] RO_S_REFUSED = 2'd2;
localparam logic [3:0] RO_E_NONE = 4'd0;   // (0.9) accepted, or off
localparam logic [3:0] RO_E_CTL = 4'd1;   // (0.9) a reserved bit of ctl or word 78 set, or FORMAT 3
localparam logic [3:0] RO_E_SIZE = 4'd2;   // (0.9) width not 1..OVL_MAX_W or height not 1..OVL_MAX_H
localparam logic [3:0] RO_E_STRIDE = 4'd3;   // (0.9) the stride not a multiple of 8, below width x bytes a pixel, or its high half set
localparam logic [3:0] RO_E_ALIGN = 4'd4;   // (0.9) the base not a multiple of 8
localparam logic [3:0] RO_E_BAND = 4'd5;   // (0.9) the band's first line after its last, or its last not below the height
localparam logic [3:0] RO_E_RANGE = 4'd6;   // (0.9) the canvas not wholly inside [FB_BYTE, FB_BYTE + FB_SIZE)
localparam logic [28:0] RI_OVL_DESC_WORD = 29'h6280048;   // (0.9) (CTRL_BYTE / 8) + OVL_WORD
localparam logic [63:0] RI_MEM_WORDS = 64'h0000000030003820;   // status words read through the clk_mem snapshot
localparam logic [63:0] RI_DEC_WORDS = 64'h0000000001FFC000;   // ... through the clk_dec snapshot
localparam int RI_NSTAT = 48;   // (0.5) status words written a frame, in RI_STAT_IX's order
// (0.5) the write order: seq_head (word 3) first, words 40-47 before 24-31, seq_tail (word 31) last
localparam int RI_STAT_A = 24;   // steps 0-23: words 0-23
localparam int RI_STAT_B = 32;   // steps 24-31: words 40-47
localparam int RI_STAT_C = 40;   // (0.10) steps 32-39: words 80-87; then 24-31
