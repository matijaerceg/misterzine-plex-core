diff --git a/libgamestream/client.c b/libgamestream/client.c
index 63e2d55..2cc4767 100644
--- a/libgamestream/client.c
+++ b/libgamestream/client.c
@@ -31,7 +31,6 @@
 #include <stdio.h>
 #include <string.h>
 #include <arpa/inet.h>
-#include <uuid/uuid.h>
 #include <openssl/sha.h>
 #include <openssl/aes.h>
 #include <openssl/rand.h>
@@ -58,6 +57,20 @@ const char* gs_error;
 
 #define UUID_STRLEN 37
 
+/* MiSTer: a random (version 4) UUID from OpenSSL instead of libuuid -- one fewer static
+ * dependency; the host only needs a fresh token per request */
+typedef unsigned char uuid_t[16];
+static void uuid_generate_random(uuid_t u) {
+  if (RAND_bytes(u, 16) != 1)
+    memset(u, 0, 16);
+  u[6] = (u[6] & 0x0f) | 0x40;
+  u[8] = (u[8] & 0x3f) | 0x80;
+}
+static void uuid_unparse(const uuid_t u, char* out) {
+  snprintf(out, UUID_STRLEN, "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+           u[0], u[1], u[2], u[3], u[4], u[5], u[6], u[7], u[8], u[9], u[10], u[11], u[12], u[13], u[14], u[15]);
+}
+
 static int mkdirtree(const char* directory) {
   char buffer[PATH_MAX];
   char* p = buffer;
